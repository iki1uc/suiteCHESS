// EYE.view – logikal + continuum

import { RESPO } from "./SUS.js";

export const EYE = {
  mode: "neutral",
  bind: false,
  scan: true,

  view(respo = RESPO) {
    return {
      mode: "neutral",
      seen: {
        OK: respo.OK,
        NOK: respo.NOK,
        FLOW: respo.FLOW,
        BREAK: respo.BREAK,
        ECHO: respo.ECHO,
        VOID: respo.VOID,
        ROOT: respo.ROOT
      },
      continuum: true,
      bind: false
    };
  }
};

